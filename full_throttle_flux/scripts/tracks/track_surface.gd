@tool
extends Node
class_name TrackSurface
## A Track Builder track's surface zones (v38 phase 3), generated by Build
## from the SurfaceZoneKeys (TrackSurfacer). Like TrackGreebles it holds
## only data; at load it makes one material per path from the shared style
## (the road segments' own material, shaders/track/track_surface_material.tres)
## and puts it on that path's road segments:
##
##   band tables   the zones' profiles in uniform arrays (at most
##                 MAX_PROFILES per path, MAX_BANDS bands each), so the band
##                 loop reads a constant buffer, not a texture
##   strip         one RGBAF texel per metre of path, ONE fetch per pixel:
##                 which profile(s), the transition there, the zone seeds
##                 and wear, and (phase 4) the wear inputs baked from the
##                 track's trained racing line (see build_strip())
##   variation     the track's TrackSurfaceVariation overrides
##   decals        (phase 5) the SurfaceDecalKeys laid out into glyph and
##                 shape records (DECAL_TEXELS texels each, sorted along s)
##                 and a per-metre strip of (first record, count): a second
##                 fetch per pixel, and a few more on metres with decals
##
## Wear (v38 phase 4) is baked when the track loads, from the trained line
## AILineTrainer saved for WEAR_SHIP (the branch: its route line, projected
## onto the BranchSpline), so it always matches the AI line: retrain the line
## and the polish and scorch follow.
##
## A track without this node (Fork Lab, the circuits later) draws the
## material's own band table (the industrial preset) and no line wear.
##
## Never edit by hand: move or change the SurfaceZoneKeys and the builder
## rewrites it.

const SURFACE_SHADER := "res://shaders/track/track_surface.gdshader"
const MAX_PROFILES := 4
const MAX_BANDS := TrackSurfaceProfile.MAX_BANDS
## Strip texture width; longer paths wrap onto more rows.
const STRIP_W := 16384
## A hard seam is filtered over the pixel footprint: texels this far either
## side of it know about it.
const SEAM_PAD := 4.0
## The ship whose trained line drives the wear.
const WEAR_SHIP := "default_racer"
## Deceleration (u/s per second) that counts as full braking for scorch.
const BRAKE_REF := 45.0
## Ships airbrake through hard corners; the trained lines carry no airbrake
## record, so cornering load (v^2 * curvature, u/s^2) stands in for it:
## scorch ramps from CORNER_FROM to CORNER_FROM + CORNER_SPAN, up to
## CORNER_SHARE of a full brake.
const CORNER_FROM := 25.0
const CORNER_SPAN := 35.0
const CORNER_SHARE := 0.6
## Braking is smeared this many metres either way (scorch builds over a zone).
const BRAKE_SMEAR := 8
## Packing ranges (see build_strip()).
const LINE_RANGE := 32.0       # line t in [-32, 32) m, 1/64 m steps
const HALF_STEP := 0.25        # corridor half width, 0.25 m steps up to 31.75 m
## Decals (phase 5).
const GLYPHS := "res://resources/track_surface/decal_glyphs.tres"
const DECAL_TEXELS := 4
## Records per row of the record texture.
const DECAL_ROW := 1024
## The shader loops over at most this many records per metre.
const DECAL_MAX := 24
## Records are listed this far beyond their own extent along s (footprint).
const DECAL_PAD := 1.0
## Stroke width as a share of the letter height, per Role: the size at which
## a glyph fades to its average (barcode bars are thinnest, first to go).
const STROKE := [0.14, 0.18, 0.09, 0.025]

## The paths the zones run along (0 = MainSpline), relative to this node.
@export var paths: Array[NodePath] = []
@export var zones: Array[TrackSurfaceZone] = []
@export var variation: TrackSurfaceVariation
@export var decals: Array[TrackSurfaceDecal] = []

## What the last apply() found (warnings for the builder report).
var notes := PackedStringArray()


func _ready() -> void:
	# After the road segments have built their meshes.
	apply.call_deferred()


## Builds the per-path materials and puts them on the road segments.
## Returns the number of segments it set.
func apply() -> int:
	notes.clear()
	var set_count := 0
	for pi in paths.size():
		var path := get_node_or_null(paths[pi]) as Path3D
		if path == null or path.curve == null:
			continue
		var segs := _surface_segments(path)
		if segs.is_empty():
			continue
		var base := segs[0].mesh.surface_get_material(0) as ShaderMaterial
		var mat := build_material(base, pi, path)
		for mi in segs:
			mi.mesh.surface_set_material(0, mat)
			set_count += 1
	return set_count


## The path's own material: `base` with this path's band tables, strip and
## the variation.
func build_material(base: ShaderMaterial, path_index: int, path: Path3D) -> ShaderMaterial:
	var mat := base.duplicate() as ShaderMaterial
	var length := path.curve.get_baked_length() if path and path.curve else 0.0
	var mine := zones_of(path_index)
	var slots: Array[TrackSurfaceProfile] = []
	for z in mine:
		if z.profile and not slots.has(z.profile):
			if slots.size() < MAX_PROFILES:
				slots.append(z.profile)
			else:
				notes.append("%s: more than %d profiles on one path; %s draws as %s" % [
						z.key_name, MAX_PROFILES, z.profile.profile_name, slots[0].profile_name])
	_add_decals(mat, path_index, path)
	if slots.is_empty():
		if variation:
			variation.apply(mat)
		return mat
	var bands := PackedVector4Array()
	bands.resize(MAX_PROFILES * MAX_BANDS)
	var info := PackedVector4Array()
	info.resize(MAX_PROFILES)
	for k in slots.size():
		var pk := slots[k].packed()
		for i in pk.size():
			bands[k * MAX_BANDS + i] = pk[i]
		var sums := slots[k].sums()
		info[k] = Vector4(pk.size(), sums.x, sums.y, 0.0)
	mat.set_shader_parameter("surf_bands", bands)
	mat.set_shader_parameter("surf_profiles", info)
	var wear := bake_wear(path, path_index)
	var strip := build_strip(mine, slots, length, path_index == 0, wear)
	mat.set_shader_parameter("surf_strip", ImageTexture.create_from_image(strip))
	mat.set_shader_parameter("surf_strip_info", Vector2(strip.get_width() * strip.get_height(),
			strip.get_width()))
	if variation:
		variation.apply(mat)
	return mat


## Lays this path's decals out into records and sets the decal textures.
func _add_decals(mat: ShaderMaterial, path_index: int, path: Path3D) -> void:
	var mine: Array[TrackSurfaceDecal] = []
	for d in decals:
		if d and d.path_index == path_index:
			mine.append(d)
	if mine.is_empty():
		return
	var glyphs := load(GLYPHS) as TrackSurfaceGlyphs
	if glyphs == null:
		notes.append("no decal atlas (%s): run tools/track_surface/make_decal_atlas.gd" % GLYPHS)
		return
	var segs := _road_segments(path)
	var records: Array = []    # {s0, t0, hs, wt, uv, kind, paint, glow, opacity, ink, stroke, flipped}
	for d in mine:
		for n in d.count:
			var sd := d.distance + n * d.spacing
			var half := _half_widths(segs, sd)
			records.append_array(layout(d, sd, half, n, glyphs))
	if records.is_empty():
		return
	records.sort_custom(func(a: Dictionary, b: Dictionary) -> bool: return a.s0 < b.s0)
	# Record texture: DECAL_TEXELS RGBAF texels per record.
	var rows := int(ceil(float(records.size()) / DECAL_ROW))
	var rw := mini(records.size(), DECAL_ROW) * DECAL_TEXELS
	var rd := PackedFloat32Array()
	rd.resize(rw * rows * 4)
	for i in records.size():
		var r: Dictionary = records[i]
		var base := ((i / DECAL_ROW) * rw + (i % DECAL_ROW) * DECAL_TEXELS) * 4
		var vals := [r.s0, r.t0, r.hs, r.wt, r.uv.x, r.uv.y, r.uv.z, r.uv.w,
				r.kind, r.paint, r.glow, r.opacity, r.ink, r.stroke, 1.0 if r.flipped else 0.0, 0.0]
		for j in vals.size():
			rd[base + j] = vals[j]
	var rec_img := Image.create_from_data(rw, rows, false, Image.FORMAT_RGBAF, rd.to_byte_array())
	# Per-metre strip: (first record, count) of those reaching that metre.
	var n := int(ceil(path.curve.get_baked_length())) + 1
	var first := PackedInt32Array()
	var last := PackedInt32Array()
	first.resize(n)
	last.resize(n)
	first.fill(-1)
	last.fill(-1)
	for i in records.size():
		var r: Dictionary = records[i]
		for m in range(int(floor(r.s0 - DECAL_PAD)), int(ceil(r.s0 + r.hs + DECAL_PAD))):
			if m < 0 or m >= n:
				continue
			first[m] = i if first[m] < 0 else mini(first[m], i)
			last[m] = maxi(last[m], i)
	var sw := mini(n, STRIP_W)
	var sh := int(ceil(float(n) / sw))
	var sd := PackedFloat32Array()
	sd.resize(sw * sh * 2)
	var over := 0
	for m in n:
		if first[m] < 0:
			continue
		var cnt := last[m] - first[m] + 1
		if cnt > DECAL_MAX:
			over = maxi(over, cnt)
			cnt = DECAL_MAX
		sd[m * 2] = first[m]
		sd[m * 2 + 1] = cnt
	if over > 0:
		notes.append("%s: up to %d decal glyphs overlap one metre (the shader draws %d): spread them out"
				% [path.name, over, DECAL_MAX])
	var strip_img := Image.create_from_data(sw, sh, false, Image.FORMAT_RGF, sd.to_byte_array())
	mat.set_shader_parameter("surf_decals", ImageTexture.create_from_image(rec_img))
	mat.set_shader_parameter("surf_decal_strip", ImageTexture.create_from_image(strip_img))
	mat.set_shader_parameter("surf_decal_atlas", glyphs.atlas())
	mat.set_shader_parameter("surf_decal_info", Vector4(n, sw, DECAL_ROW, glyphs.px_range))


## The records for one copy of decal `d` whose baseline (shapes: start) is
## at `sd` along the path; `half` = the surface half widths there, `n` = which
## copy (for "#" in the text).
static func layout(d: TrackSurfaceDecal, sd: float, half: Vector2, n: int,
		glyphs: TrackSurfaceGlyphs) -> Array:
	var out: Array = []
	if d.shape != TrackSurfaceDecal.Shape.TEXT:
		var c := _anchor_centre(d, half, d.width)
		var th := 0.2 * minf(d.width, d.size)
		var ink := clampf(th * (d.size + d.width) / (d.width * d.size), 0.05, 0.6)
		out.append({s0 = sd, t0 = c - d.width * 0.5, hs = d.size, wt = d.width, uv = Vector4.ZERO,
				kind = float(d.shape), paint = float(d.paint), glow = d.glow, opacity = d.opacity,
				ink = ink, stroke = th, flipped = false})
		return out
	var text := decal_text(d.text, d.role, n)
	var k := d.size / glyphs.em_px     # metres per atlas pixel
	var space := 0.3 * glyphs.em_px
	var total := 0.0
	for ch in text:
		var key := TrackSurfaceGlyphs.key(d.role, ch.unicode_at(0))
		total += float(glyphs.advances[key]) if glyphs.advances.has(key) else space
	var width := total * k
	var c := _anchor_centre(d, half, width)
	var pen := c - width * 0.5
	var aw := float(glyphs.atlas_size.x)
	var ah := float(glyphs.atlas_size.y)
	var stroke: float = STROKE[d.role] * d.size
	for ch in text:
		var key := TrackSurfaceGlyphs.key(d.role, ch.unicode_at(0))
		if not glyphs.rects.has(key):
			pen += space * k
			continue
		var r: Vector4 = glyphs.rects[key]
		var o: Vector2 = glyphs.offsets[key]
		var t0 := pen + o.x * k
		var s0 := sd - (o.y + r.w) * k
		if d.flipped:
			# Turned round the decal's centre: for ships coming the other way.
			t0 = 2.0 * c - (t0 + r.z * k)
			s0 = 2.0 * sd - (s0 + r.w * k)
		out.append({s0 = s0, t0 = t0, hs = r.w * k, wt = r.z * k,
				uv = Vector4(r.x / aw, r.y / ah, (r.x + r.z) / aw, (r.y + r.w) / ah),
				kind = 0.0, paint = float(d.paint), glow = d.glow, opacity = d.opacity,
				ink = float(glyphs.inks[key]), stroke = stroke, flipped = d.flipped})
		pen += float(glyphs.advances[key]) * k
	return out


## The text as drawn: WORD (Bartle) is caps only, "#" counts copies from 1.
static func decal_text(text: String, role: int, n: int) -> String:
	var t := text.replace("#", str(n + 1))
	return t.to_upper() if role == TrackSurfaceDecal.Role.WORD else t


static func _anchor_centre(d: TrackSurfaceDecal, half: Vector2, width: float) -> float:
	match d.anchor:
		TrackSurfaceDecal.Anchor.LEFT:
			return -half.x + d.offset + width * 0.5
		TrackSurfaceDecal.Anchor.RIGHT:
			return half.y + d.offset - width * 0.5
	return d.offset


static func _road_segments(path: Path3D) -> Array[TrackRoadSegment]:
	var out: Array[TrackRoadSegment] = []
	for c in path.get_children():
		var seg := c as TrackRoadSegment
		if seg and not (seg.collision_layer & 4):
			out.append(seg)
	return out


## Surface half widths at `d` from the road segment covering it (the first
## one if none does).
static func _half_widths(segs: Array[TrackRoadSegment], d: float) -> Vector2:
	if segs.is_empty():
		return Vector2(19.5, 19.5)
	for seg in segs:
		var d1 := seg.end_distance if seg.end_distance >= 0.0 else INF
		if d >= seg.start_distance and d <= d1:
			return seg.surface_half_widths_at(d)
	return segs[0].surface_half_widths_at(d)


static func decal_signature(d: TrackSurfaceDecal) -> Array:
	return [d.path_index, snappedf(d.distance, 0.01), d.anchor, snappedf(d.offset, 0.01), d.shape, d.role,
			d.text, snappedf(d.size, 0.01), snappedf(d.width, 0.01), d.paint, snappedf(d.glow, 0.01),
			snappedf(d.opacity, 0.01), d.count, snappedf(d.spacing, 0.01), d.flipped]


## Wear inputs per metre of `path` from the trained racing line:
## {line: racing line t (m), half: corridor half width (m), brake: heat for
## the scorch, 0..1, from braking and hard cornering};
## empty when there's no trained line for it.
func bake_wear(path: Path3D, path_index: int) -> Dictionary:
	var track_id := AILineTrainer.track_id_for(get_parent())
	if track_id.is_empty() or path == null:
		return {}
	var line_id := track_id if path_index == 0 else "%s__route%d" % [track_id, path_index - 1]
	var line := AILineTrainer.load_trained_line(line_id, WEAR_SHIP)
	if line == null or line.sample_count < 2 or line.lateral_offsets.size() < line.sample_count:
		notes.append("no trained line %s for %s: no line wear there" % [line_id, path.name])
		return {}
	var n := int(ceil(path.curve.get_baked_length())) + 1
	var lt := PackedFloat32Array()
	var half := PackedFloat32Array()
	var brake := PackedFloat32Array()
	lt.resize(n)
	half.resize(n)
	brake.resize(n)
	# The branch's route line runs a whole lap through it: find each branch
	# metre's place on the route spline.
	var route: Path3D = null
	if path_index > 0:
		var nm := "RouteSpline_Branch" if path_index == 1 else "RouteSpline_Branch_%d" % path_index
		route = get_parent().get_node_or_null(nm) as Path3D
		if route == null or route.curve == null:
			notes.append("no %s: no line wear on %s" % [nm, path.name])
			return {}
	var route_len := route.curve.get_baked_length() if route else 0.0
	var N := line.sample_count
	var ds := line.track_length / N if line.track_length > 0.0 else 1.0
	var decel := PackedFloat32Array()    # heat per metre, before smearing
	decel.resize(n)
	for i in n:
		var frac := (float(i) + 0.5) / maxf(path.curve.get_baked_length(), 1.0)
		if route:
			var wp := path.global_transform * path.curve.sample_baked(minf(i + 0.5, path.curve.get_baked_length()))
			frac = route.curve.get_closest_offset(route.global_transform.affine_inverse() * wp) / route_len
		var f := fposmod(frac, 1.0) * N
		var k0 := int(floorf(f)) % N
		var k1 := (k0 + 1) % N
		var w := f - floorf(f)
		lt[i] = lerpf(line.lateral_offsets[k0], line.lateral_offsets[k1], w)
		if line.corridor_min.size() == N and line.corridor_max.size() == N:
			half[i] = 0.5 * lerpf(line.corridor_max[k0] - line.corridor_min[k0],
					line.corridor_max[k1] - line.corridor_min[k1], w)
		else:
			half[i] = 15.0
		# Heat: deceleration from the speed profile (v dv/ds, braking
		# positive), or cornering load as the airbrake's stand-in.
		if line.target_speeds.size() == N:
			var va := line.target_speeds[k0]
			var vb := line.target_speeds[k1]
			var heat := maxf((va * va - vb * vb) / (2.0 * ds), 0.0) / BRAKE_REF
			if line.curvatures.size() == N:
				var a_lat := va * va * absf(line.curvatures[k0])
				heat = maxf(heat, CORNER_SHARE * clampf((a_lat - CORNER_FROM) / CORNER_SPAN, 0.0, 1.0))
			decel[i] = heat
	for i in n:
		var acc := 0.0
		for j in range(-BRAKE_SMEAR, BRAKE_SMEAR + 1):
			acc += decel[posmod(i + j, n)] if path_index == 0 else decel[clampi(i + j, 0, n - 1)]
		brake[i] = clampf(acc / (2 * BRAKE_SMEAR + 1), 0.0, 1.0)
	return {line = lt, half = half, brake = brake}


## The strip: texel i covers metres [i, i + 1). Every channel holds an exact
## integer (or, G, a distance), so the shader can unpack bits:
##   R  slot A | slot B << 2 | seed A << 4 | seed B << 14
##   G  transition start, metres (< 0: no transition here)
##   B  transition length (m, 0..255; 0 = hard seam) | brake (6 bits) << 8 |
##      zone wear (6 bits, 0..2 in 63 steps) << 14
##   A  racing line t ((t + 32) * 64, 12 bits) | corridor half width (0.25 m
##      steps, 7 bits) << 12 | has a line << 19
## Before the transition start the shader draws A, after start + length B, a
## cross-fade between.
static func build_strip(mine: Array[TrackSurfaceZone], slots: Array[TrackSurfaceProfile],
		length: float, closed: bool, wear: Dictionary = {}) -> Image:
	var n := maxi(int(ceil(length)) + 1, 1)
	var sa := PackedInt32Array()
	var sb := PackedInt32Array()
	var da := PackedInt32Array()
	var db := PackedInt32Array()
	var s0 := PackedFloat32Array()
	var blend := PackedInt32Array()
	var zwear := PackedInt32Array()
	# (Packed arrays are values: resize each one itself.)
	sa.resize(n)
	sb.resize(n)
	da.resize(n)
	db.resize(n)
	blend.resize(n)
	zwear.resize(n)
	s0.resize(n)
	s0.fill(-1.0)
	zwear.fill(31)
	var slot_of := func(z: TrackSurfaceZone) -> int:
		return maxi(slots.find(z.profile), 0)
	# Plain zones.
	for z in mine:
		var sl: int = slot_of.call(z)
		var zw := clampi(roundi(z.wear / 2.0 * 63.0), 0, 63)
		for i in range(int(floor(z.from_d)), int(ceil(z.to_d))):
			var idx := posmod(i, n) if closed else i
			if idx < 0 or idx >= n:
				continue
			sa[idx] = sl
			sb[idx] = sl
			da[idx] = z.seed & 1023
			db[idx] = z.seed & 1023
			zwear[idx] = zw
	# Transitions: each zone from the one in force just before it.
	for zi in mine.size():
		var z := mine[zi]
		var prev := _zone_before(mine, zi, closed)
		if prev == null or prev == z:
			continue
		var start := z.from_d
		var bl := clampi(roundi(z.blend_in), 0, 255)
		for i in range(int(floor(start - SEAM_PAD)), int(ceil(start + bl + SEAM_PAD))):
			var idx := i
			var start_here := start
			if closed:
				idx = posmod(i, n)
				start_here = start - length * floor(float(i) / n)
			if idx < 0 or idx >= n:
				continue
			sa[idx] = slot_of.call(prev)
			sb[idx] = slot_of.call(z)
			da[idx] = prev.seed & 1023
			db[idx] = z.seed & 1023
			s0[idx] = start_here
			blend[idx] = bl
	var has_line := not wear.is_empty()
	var data := PackedFloat32Array()
	var w := mini(n, STRIP_W)
	var h := int(ceil(float(n) / w))
	data.resize(w * h * 4)
	for i in n:
		data[i * 4] = sa[i] | (sb[i] << 2) | (da[i] << 4) | (db[i] << 14)
		data[i * 4 + 1] = s0[i]
		var br := 0
		var la := 0
		if has_line and i < (wear.line as PackedFloat32Array).size():
			br = clampi(roundi(float(wear.brake[i]) * 63.0), 0, 63)
			var lq := clampi(roundi((float(wear.line[i]) + LINE_RANGE) * 64.0), 0, 4095)
			var hq := clampi(roundi(float(wear.half[i]) / HALF_STEP), 0, 127)
			la = lq | (hq << 12) | (1 << 19)
		data[i * 4 + 2] = blend[i] | (br << 8) | (zwear[i] << 14)
		data[i * 4 + 3] = la
	return Image.create_from_data(w, h, false, Image.FORMAT_RGBAF, data.to_byte_array())


func zones_of(path_index: int) -> Array[TrackSurfaceZone]:
	var out: Array[TrackSurfaceZone] = []
	for z in zones:
		if z and z.path_index == path_index:
			out.append(z)
	out.sort_custom(func(a: TrackSurfaceZone, b: TrackSurfaceZone) -> bool: return a.from_d < b.from_d)
	return out


## The zone in force just before `mine[zi]` starts (the lap wraps on the
## main track), or null.
static func _zone_before(mine: Array[TrackSurfaceZone], zi: int, closed: bool) -> TrackSurfaceZone:
	if zi > 0:
		return mine[zi - 1]
	return mine[mine.size() - 1] if closed and mine.size() > 1 else null


## The road segments of `path` drawn with the track surface shader.
static func _surface_segments(path: Path3D) -> Array[MeshInstance3D]:
	var out: Array[MeshInstance3D] = []
	for c in path.get_children():
		var seg := c as TrackRoadSegment
		if seg == null:
			continue
		var mi := seg.mesh_instance()
		if mi == null or mi.mesh == null or mi.mesh.get_surface_count() == 0:
			continue
		var sm := mi.mesh.surface_get_material(0) as ShaderMaterial
		if sm and sm.shader and sm.shader.resource_path == SURFACE_SHADER:
			out.append(mi)
	return out


## For the validator: what the node holds.
func signature() -> int:
	var parts := [paths, variation.get_instance_id() if variation else 0]
	for z in zones:
		if z:
			parts.append([z.path_index, snappedf(z.from_d, 0.01), snappedf(z.to_d, 0.01),
					z.profile.get_instance_id() if z.profile else 0, snappedf(z.blend_in, 0.01), z.seed,
					snappedf(z.wear, 0.01)])
	for d in decals:
		if d:
			parts.append(decal_signature(d))
	return hash(var_to_bytes(parts))
