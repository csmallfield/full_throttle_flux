@tool
extends Node
class_name TrackSurface
## A Track Builder track's surface zones (v38 phase 3), generated by Build
## from the SurfaceZoneKeys (TrackSurfacer). Like TrackGreebles it holds
## only data; at load it makes one material per path from the shared style
## (the road segments' own material, shaders/track/track_surface_material.tres)
## and puts it on that path's road segments:
##
##   band tables   the zones' profiles in uniform arrays (at most
##                 MAX_PROFILES per path, MAX_BANDS bands each), so the band
##                 loop reads a constant buffer, not a texture
##   zone strip    one RGBAF texel per metre of path: which profile(s), the
##                 transition there (start, length; 0 = hard seam) and the
##                 zone seeds. The shader fetches one texel per pixel.
##   variation     the track's TrackSurfaceVariation overrides
##
## A track without this node (Fork Lab, the circuits later) draws the
## material's own band table: the industrial preset.
##
## Never edit by hand: move or change the SurfaceZoneKeys and the builder
## rewrites it.

const SURFACE_SHADER := "res://shaders/track/track_surface.gdshader"
const MAX_PROFILES := 4
const MAX_BANDS := TrackSurfaceProfile.MAX_BANDS
## Strip texture width; longer paths wrap onto more rows.
const STRIP_W := 16384
## A hard seam is filtered over the pixel footprint: texels this far either
## side of it know about it.
const SEAM_PAD := 4.0

## The paths the zones run along (0 = MainSpline), relative to this node.
@export var paths: Array[NodePath] = []
@export var zones: Array[TrackSurfaceZone] = []
@export var variation: TrackSurfaceVariation

## What the last apply() found (warnings for the builder report).
var notes := PackedStringArray()


func _ready() -> void:
	# After the road segments have built their meshes.
	apply.call_deferred()


## Builds the per-path materials and puts them on the road segments.
## Returns the number of segments it set.
func apply() -> int:
	notes.clear()
	var set_count := 0
	for pi in paths.size():
		var path := get_node_or_null(paths[pi]) as Path3D
		if path == null or path.curve == null:
			continue
		var segs := _surface_segments(path)
		if segs.is_empty():
			continue
		var base := segs[0].mesh.surface_get_material(0) as ShaderMaterial
		var mat := build_material(base, pi, path.curve.get_baked_length())
		for mi in segs:
			mi.mesh.surface_set_material(0, mat)
			set_count += 1
	return set_count


## The path's own material: `base` with this path's band tables, strip and
## the variation.
func build_material(base: ShaderMaterial, path_index: int, length: float) -> ShaderMaterial:
	var mat := base.duplicate() as ShaderMaterial
	var mine := zones_of(path_index)
	var slots: Array[TrackSurfaceProfile] = []
	for z in mine:
		if z.profile and not slots.has(z.profile):
			if slots.size() < MAX_PROFILES:
				slots.append(z.profile)
			else:
				notes.append("%s: more than %d profiles on one path; %s draws as %s" % [
						z.key_name, MAX_PROFILES, z.profile.profile_name, slots[0].profile_name])
	if slots.is_empty():
		return mat
	var bands := PackedVector4Array()
	bands.resize(MAX_PROFILES * MAX_BANDS)
	var info := PackedVector4Array()
	info.resize(MAX_PROFILES)
	for k in slots.size():
		var pk := slots[k].packed()
		for i in pk.size():
			bands[k * MAX_BANDS + i] = pk[i]
		var sums := slots[k].sums()
		info[k] = Vector4(pk.size(), sums.x, sums.y, 0.0)
	mat.set_shader_parameter("surf_bands", bands)
	mat.set_shader_parameter("surf_profiles", info)
	var strip := build_strip(mine, slots, length, path_index == 0)
	mat.set_shader_parameter("surf_strip", ImageTexture.create_from_image(strip))
	mat.set_shader_parameter("surf_strip_info", Vector2(strip.get_width() * strip.get_height(),
			strip.get_width()))
	if variation:
		variation.apply(mat)
	return mat


## The zone strip: texel i covers metres [i, i + 1). R = profile slot A +
## 16 * slot B, G = transition start (< 0: none), B = transition length (0 =
## hard), A = seed A + 1024 * seed B. Before the transition start the shader
## draws A, after start + length B, a cross-fade between.
static func build_strip(mine: Array[TrackSurfaceZone], slots: Array[TrackSurfaceProfile],
		length: float, closed: bool) -> Image:
	var n := maxi(int(ceil(length)) + 1, 1)
	var data := PackedFloat32Array()
	data.resize(n * 4)
	var slot_of := func(z: TrackSurfaceZone) -> int:
		return maxi(slots.find(z.profile), 0)
	# Plain zones.
	for z in mine:
		var sl: int = slot_of.call(z)
		for i in range(int(floor(z.from_d)), int(ceil(z.to_d))):
			var idx := posmod(i, n) if closed else i
			if idx < 0 or idx >= n:
				continue
			data[idx * 4] = sl + 16 * sl
			data[idx * 4 + 1] = -1.0
			data[idx * 4 + 2] = 0.0
			data[idx * 4 + 3] = z.seed + 1024 * z.seed
	# Transitions: each zone from the one in force just before it.
	for zi in mine.size():
		var z := mine[zi]
		var prev := _zone_before(mine, zi, closed)
		if prev == null or prev == z:
			continue
		var a: int = slot_of.call(prev)
		var b: int = slot_of.call(z)
		var s0 := z.from_d
		var blend := maxf(z.blend_in, 0.0)
		for i in range(int(floor(s0 - SEAM_PAD)), int(ceil(s0 + blend + SEAM_PAD))):
			var idx := i
			var s0_here := s0
			if closed:
				idx = posmod(i, n)
				s0_here = s0 - length * floor(float(i) / n)
			if idx < 0 or idx >= n:
				continue
			data[idx * 4] = a + 16 * b
			data[idx * 4 + 1] = s0_here
			data[idx * 4 + 2] = blend
			data[idx * 4 + 3] = prev.seed + 1024 * z.seed
	var w := mini(n, STRIP_W)
	var h := int(ceil(float(n) / w))
	data.resize(w * h * 4)
	return Image.create_from_data(w, h, false, Image.FORMAT_RGBAF, data.to_byte_array())


func zones_of(path_index: int) -> Array[TrackSurfaceZone]:
	var out: Array[TrackSurfaceZone] = []
	for z in zones:
		if z and z.path_index == path_index:
			out.append(z)
	out.sort_custom(func(a: TrackSurfaceZone, b: TrackSurfaceZone) -> bool: return a.from_d < b.from_d)
	return out


## The zone in force just before `mine[zi]` starts (the lap wraps on the
## main track), or null.
static func _zone_before(mine: Array[TrackSurfaceZone], zi: int, closed: bool) -> TrackSurfaceZone:
	if zi > 0:
		return mine[zi - 1]
	return mine[mine.size() - 1] if closed and mine.size() > 1 else null


## The road segments of `path` drawn with the track surface shader.
static func _surface_segments(path: Path3D) -> Array[MeshInstance3D]:
	var out: Array[MeshInstance3D] = []
	for c in path.get_children():
		var seg := c as TrackRoadSegment
		if seg == null:
			continue
		var mi := seg.mesh_instance()
		if mi == null or mi.mesh == null or mi.mesh.get_surface_count() == 0:
			continue
		var sm := mi.mesh.surface_get_material(0) as ShaderMaterial
		if sm and sm.shader and sm.shader.resource_path == SURFACE_SHADER:
			out.append(mi)
	return out


## For the validator: what the node holds.
func signature() -> int:
	var parts := [paths, variation.get_instance_id() if variation else 0]
	for z in zones:
		if z:
			parts.append([z.path_index, snappedf(z.from_d, 0.01), snappedf(z.to_d, 0.01),
					z.profile.get_instance_id() if z.profile else 0, snappedf(z.blend_in, 0.01), z.seed])
	return hash(var_to_bytes(parts))
